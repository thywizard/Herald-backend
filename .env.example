# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real keys.

PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string_here

# Google Gemini API key (AI Studio) — primary rewrite provider
GEMINI_API_KEY=your_gemini_key_here

# Groq API key (console.groq.com) — fallback rewrite provider, used
# automatically whenever Gemini fails or hits its rate limit
GROQ_API_KEY=your_groq_key_here

# NewsData.io API key
NEWSDATA_API_KEY=your_newsdata_key_here

# Toggle: true = AI-ingested articles publish immediately, false = land in pending queue
AUTO_PUBLISH=true

# Long random password for the admin dashboard — generate any long random
# string, e.g. from a password manager. Never share this in chat.
ADMIN_KEY=your_long_random_admin_password_here

# Optional: comma-separated list of editor passwords (limited permissions —
# can write/edit articles, cannot delete/pin/unpublish or manage the site).
# Leave blank if you don't want editor accounts yet.
EDITOR_KEYS=

# Cloudinary — for uploading article images from the admin dashboard.
# Paste your CLOUDINARY_URL exactly as Cloudinary gives it to you
# (format: cloudinary://<api_key>:<api_secret>@<cloud_name>).
# The SDK reads this automatically — no other config needed.
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name

# Web Push (real native Android/desktop notifications — not a Firebase
# project, just a VAPID keypair). VAPID_PUBLIC_KEY is also needed on the
# frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value, it's public).
# VAPID_SUBJECT should be "mailto:your-email@example.com" — push services
# use it to contact you if your server is misbehaving, it's never shown
# to users.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# --- Web search (the Search tab) ---
# All three are optional and independent — whichever you configure get
# queried and merged. Leave any of them blank to skip that source.

# Your self-hosted SearXNG instance (see herald-searxng/ for the deploy
# files) — no API key needed, this is just its URL, e.g.
# https://herald-searxng.onrender.com
SEARXNG_URL=

# Brave Search API — subscribe (free, no charge) at
# https://api-dashboard.search.brave.com/ to get a key.
BRAVE_API_KEY=

# Google Custom Search JSON API — create a Custom Search Engine at
# programmablesearchengine.google.com (set it to search the whole web,
# not just one site) for GOOGLE_CSE_ID, and a matching API key at
# console.cloud.google.com (enable "Custom Search API") for
# GOOGLE_CSE_API_KEY. Free up to 100 queries/day.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- Herald AI (the Herald AI tab) ---
# A separate AI provider/key from the ones used for news ingest above —
# keeping them separate means chat traffic never eats into the ingest
# pipeline's already-tight free quota.
# HERALD_AI_PROVIDER: "openai" (default — any OpenAI-compatible chat API:
# Groq, OpenRouter, Together, DeepSeek, Mistral, etc.) or "gemini".
HERALD_AI_PROVIDER=openai
HERALD_AI_API_KEY=your_herald_ai_key_here
# Only used when HERALD_AI_PROVIDER=openai — the base URL of whichever
# OpenAI-compatible provider you signed up with, e.g.:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Together:   https://api.together.xyz/v1
#   DeepSeek:   https://api.deepseek.com/v1
HERALD_AI_BASE_URL=https://api.groq.com/openai/v1
# The model name as that provider names it, e.g. "openai/gpt-oss-120b" on
# Groq, "openai/gpt-oss-120b:free" on OpenRouter, "gemini-3.5-flash" if
# HERALD_AI_PROVIDER=gemini.
HERALD_AI_MODEL=openai/gpt-oss-120b
# Only used/useful for OpenRouter — identifies Herald to them. Set
# HERALD_AI_SITE_URL to your live frontend URL once you have one.
HERALD_AI_SITE_URL=https://herald-frontend-ruby.vercel.app
HERALD_AI_SITE_NAME=Herald
