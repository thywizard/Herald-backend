# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real keys.

PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string_here

# Google Gemini API key (AI Studio) — primary rewrite provider
GEMINI_API_KEY=your_gemini_key_here

# Groq API key (console.groq.com) — fallback rewrite provider, used
# automatically whenever Gemini fails or hits its rate limit
GROQ_API_KEY=your_groq_key_here

# NewsData.io API key
NEWSDATA_API_KEY=your_newsdata_key_here

# Toggle: true = AI-ingested articles publish immediately, false = land in pending queue
AUTO_PUBLISH=true

# Long random password for the admin dashboard — generate any long random
# string, e.g. from a password manager. Never share this in chat.
ADMIN_KEY=your_long_random_admin_password_here

# Optional: comma-separated list of editor passwords (limited permissions —
# can write/edit articles, cannot delete/pin/unpublish or manage the site).
# Leave blank if you don't want editor accounts yet.
EDITOR_KEYS=

# Cloudinary — for uploading article images from the admin dashboard.
# Paste your CLOUDINARY_URL exactly as Cloudinary gives it to you
# (format: cloudinary://<api_key>:<api_secret>@<cloud_name>).
# The SDK reads this automatically — no other config needed.
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name
